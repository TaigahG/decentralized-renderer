{
  "name": "tradetrust-decentralized-renderer",
  "version": "0.1.0-development",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/TradeTrust/tradetrust-decentralized-renderer.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "run-s check-types build:css build:app",
    "build:css": "cross-env NODE_ENV=production tailwindcss -c tailwind.config.js -i src/tailwind.css -o src/main.css",
    "build:app": "vite build",
    "check-types": "tsc --sourceMap false --noEmit",
    "dev": "run-s build:css dev:server",
    "dev:server": "vite",
    "storybook": "rm -rf node_modules/.cache/storybook && run-s build:css storybook:start",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "npm run build:css && storybook build -o storybook-static",
    "build-storybook": "npm run build:css && storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@tradetrust-tt/decentralized-renderer-react-components": "^3.16.12",
    "@trustvc/trustvc": "^2.0.0",
    "date-fns": "^3.3.1",
    "debug": "^4.3.4",
    "escape-goat": "4.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@mattrglobal/node-bbs-signatures": "^0.20.0",
    "@storybook/addon-essentials": "^8.5.6",
    "@storybook/addon-interactions": "^8.5.6",
    "@storybook/addon-links": "^8.5.6",
    "@storybook/addon-onboarding": "^8.5.6",
    "@storybook/blocks": "^8.5.6",
    "@storybook/react": "^8.5.6",
    "@storybook/react-vite": "^8.5.6",
    "@storybook/test": "^8.5.6",
    "@types/debug": "^4.1.12",
    "@types/node": "^20.11.19",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "storybook": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "engines": {
    "node": ">=18.x"
  }
}
